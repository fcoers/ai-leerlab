<?xml version="1.0" encoding="UTF-8"?>
<!-- Lesquiz-dashboard als invoegtoepassing voor PowerPoint (inhoud op een dia). Eenmalig installeren: zie de handleiding. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>3d644fa5-3bfd-4726-9ef4-6b63525d7cf4</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>AI-leerlab</ProviderName>
  <DefaultLocale>nl-NL</DefaultLocale>
  <DisplayName DefaultValue="Lesquiz-dashboard"/>
  <Description DefaultValue="Toont het live dashboard van de lesquiz van AI-leerlab op een dia."/>
  <IconUrl DefaultValue="https://ai-leerlab.nl/favicon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://ai-leerlab.nl/icon-512.png"/>
  <SupportUrl DefaultValue="https://ai-leerlab.nl/over/"/>
  <AppDomains>
    <AppDomain>https://ai-leerlab.nl</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://ai-leerlab.nl/apps/lesquiz/powerpoint/"/>
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>540</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
